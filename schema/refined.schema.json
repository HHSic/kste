{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refined.schema.json",
  "title": "KSTE refined.yaml",
  "type": "object",
  "required": [
    "refined"
  ],
  "additionalProperties": false,
  "properties": {
    "refined": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "surface",
          "suggest",
          "category",
          "source",
          "tier",
          "severity",
          "status",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:DEP-)?K\\d\\.\\d{1,2}-\\d{3}$",
            "description": "확정 규칙 ID(docs/KSTE-규칙.md §13.5) + 일련번호. DEP- 접두는 확정본에서 삭제된 초안 규칙."
          },
          "draft_id": {
            "type": "string",
            "pattern": "^K\\d\\.\\d{1,2}-\\d{3}$",
            "description": "설계안 §2 초안 ID(추적용)."
          },
          "deprecated_reason": {
            "type": "string",
            "minLength": 8,
            "description": "status=deprecated 일 때 필수. 확정 규칙 문서 §13 참조."
          },
          "severity_by_genre": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "procedural": {
                "enum": [
                  "error",
                  "warn",
                  "info"
                ]
              },
              "descriptive": {
                "enum": [
                  "error",
                  "warn",
                  "info"
                ]
              }
            },
            "description": "장르별 등급(절차문/서술문). 규칙 문서가 장르별 등급을 둔 항목에만 둔다. severity 는 기본 등급."
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "suggest": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "한자어→쉬운말",
              "외래어→우리말",
              "표기"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 8,
            "description": "출처 필수: 문서+쪽(+pair id) 또는 원문 증거. 비어 있으면 검증 실패."
          },
          "source_docs": {
            "type": "array",
            "items": {
              "enum": [
                "hannune",
                "bareugo2013",
                "report2021",
                "jindan2019",
                "giljabi"
              ]
            },
            "uniqueItems": true
          },
          "pair_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^v2-\\d{4}$"
            },
            "uniqueItems": true
          },
          "tier": {
            "const": 0
          },
          "severity": {
            "enum": [
              "error",
              "warn",
              "info"
            ]
          },
          "corpus_hits": {
            "type": "object",
            "required": [
              "B",
              "C",
              "D"
            ],
            "additionalProperties": false,
            "properties": {
              "B": {
                "type": "integer",
                "minimum": 0
              },
              "C": {
                "type": "integer",
                "minimum": 0
              },
              "D": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "B 사용자 매뉴얼 / C 기술 보고서 / D 개발자 문서 코퍼스에서 surface 정규식이 일치한 횟수."
          },
          "practice": {
            "enum": [
              "tolerated"
            ],
            "description": "tolerated=잘 쓴 기술문서에서 10만 자당 5회 이상 쓰는 표현. severity 는 info 로 낮춘다."
          },
          "show_by_default": {
            "type": "boolean",
            "description": "false 이면 린터가 기본 출력에서 숨긴다(--all 에서만 표시). suggest 는 유지한다."
          },
          "severity_before_practice": {
            "enum": [
              "error",
              "warn",
              "info"
            ],
            "description": "실무 기준 등급 조정 전 등급(추적용). 조정된 항목에만 둔다."
          },
          "status": {
            "enum": [
              "proposed",
              "approved",
              "deprecated"
            ],
            "description": "proposed=제안(초안). 사람이 승인하면 approved. 승인 전에는 확정이 아니다. deprecated=확정 규칙 문서에서 삭제된 초안 규칙(deprecated_reason 필수, severity info)."
          },
          "note": {
            "type": "string"
          },
          "examples": {
            "type": "object",
            "properties": {
              "bad": {
                "type": "string",
                "minLength": 1
              },
              "good": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "bad"
            ],
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "deprecated"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "deprecated_reason"
              ],
              "properties": {
                "severity": {
                  "const": "info"
                }
              }
            }
          }
        ]
      }
    }
  }
}
