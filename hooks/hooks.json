{
  "description": "KSTE: 세션 자동 스킬 적용·Kiwi 준비와 한국어 Markdown 검사",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/kste-hook.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/integrations/claude/session-hook.mjs\"",
            "timeout": 180
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/integrations/claude/session-hook.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "modules": [
    "./kste-mod.js"
  ]
}
